{
  "name": "grade-a-api",
  "version": "1.0.0",
  "description": "Cloudflare Worker Hono REST API for Indian Grade A Government Examinations Intelligence Platform",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply grade_a_db --local",
    "db:seed": "wrangler d1 execute grade_a_db --local --file=./migrations/0002_seed_data.sql"
  },
  "keywords": [
    "cloudflare-worker",
    "hono",
    "d1",
    "grade-a",
    "upsc",
    "rbi",
    "psu",
    "eligibility-engine"
  ],
  "author": "Indian Grade A Intelligence Team",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.6.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241018.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.80.0"
  }
}
